# Ice Creams runs with no secrets and no backend services.
# Every value below is optional - copy this file to .env.local only if you need it.

# Absolute URL of the site, used for canonical and Open Graph metadata.
# On Vercel this falls back to NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL (the
# stable production domain), so set it only for a custom domain or a
# self-hosted deploy.
# NEXT_PUBLIC_SITE_URL=https://ice-creams.vercel.app
