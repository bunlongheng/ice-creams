# Ice Creams runs with no secrets and no backend services.
# Every value below is optional - copy this file to .env.local only if you need it.

# Absolute URL of the deployment, used for canonical and Open Graph metadata.
# Vercel sets NEXT_PUBLIC_VERCEL_URL automatically, so this is only needed for a
# custom domain or a self-hosted deploy.
# NEXT_PUBLIC_SITE_URL=https://ice-creams.vercel.app
